# Copy to .env.deploy (gitignored). The app's own .env already lives on the server and is left untouched.
DEV_HOST=77.68.99.7
DEV_USER=root
# Prefer SSH key auth (ssh-copy-id root@77.68.99.7). Password login needs sshpass:
