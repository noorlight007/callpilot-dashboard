# Server-only Django API origin (or an origin including /api/v1).
# Use http for local development and https for staging/production.
API_BASE_URL=http://127.0.0.1:8000
# Optional existing billing UI publishable key (safe to expose).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# JobAdder/Telnyx/Microsoft/finance/MCP credentials belong in Django, not here.

# Public URL of THIS dashboard (not the Django API), required behind an HTTPS proxy.
# Include scheme and non-default port if used; no path or /api/v1 suffix.
# Example: DASHBOARD_ORIGIN=https://dashboard.example.com
DASHBOARD_ORIGIN=
